# Required to accept requests and use private dashboard (Neon pooled connection)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# At least 32 high-entropy random characters. Used to HMAC-hash IP addresses.
RATE_LIMIT_SECRET=""
# Optional outbound notifications; configure and verify sender domain first
RESEND_API_KEY=""
NOTIFY_TO="info@sapphirequestravel.com"
NOTIFY_FROM="Sapphire Quest <notifications@sapphirequestravel.com>"
# Local bootstrap only: ADMIN_EMAIL and ADMIN_PASSWORD passed to npm run bootstrap:admin
# No travel inventory or payment secrets are required for phase 1.

# Optional: actual airport autocomplete, no live fare search until authorised
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
AMADEUS_ENVIRONMENT="test"
# Optional: ImageKit authenticated browser uploads for staff package gallery
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
